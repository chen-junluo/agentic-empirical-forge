#!/usr/bin/env python3
"""Pre-commit hook: prevent committing user-specific rules or *.local.md files."""

import re
import subprocess
import sys
from pathlib import Path


def get_staged_files():
    """Get list of staged files."""
    result = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"],
        capture_output=True,
        text=True,
        check=True,
    )
    return [f for f in result.stdout.strip().split("\n") if f]


def get_file_content(filepath):
    """Get staged content of a file."""
    result = subprocess.run(
        ["git", "show", f":{filepath}"],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        return None
    return result.stdout


def check_agent_file(filepath, content):
    """Check if agent file has substantive content after User-Specific Rules heading."""
    # Find the User-Specific Rules section
    match = re.search(
        r"^## User-Specific Rules\s*$(.*)",
        content,
        re.MULTILINE | re.DOTALL,
    )

    if not match:
        # No User-Specific Rules section found, which is fine for non-agent files
        return True, None

    after_heading = match.group(1).strip()

    # Remove the standard instruction line
    after_heading = re.sub(
        r"若同目录存在\s+`[^`]+\.local\.md`[^。]*。",
        "",
        after_heading,
    ).strip()

    # Check if there's any substantive content left
    # Allow HTML comments and whitespace
    without_comments = re.sub(r"<!--.*?-->", "", after_heading, flags=re.DOTALL).strip()

    if without_comments:
        return False, (
            f"  {filepath}\n"
            f"  Found substantive content after '## User-Specific Rules'.\n"
            f"  Move it to '{Path(filepath).stem}.local.md' instead."
        )

    return True, None


def main():
    """Main pre-commit check."""
    staged_files = get_staged_files()

    if not staged_files:
        return 0

    errors = []

    for filepath in staged_files:
        # Check 1: Block *.local.md files
        if filepath.endswith(".local.md"):
            errors.append(
                f"  {filepath}\n"
                f"  *.local.md files should not be committed (they are gitignored).\n"
                f"  Use 'git reset HEAD {filepath}' to unstage."
            )
            continue

        # Check 2: For agent/*.md files, check User-Specific Rules section
        if "/agents/" in filepath and filepath.endswith(".md"):
            content = get_file_content(filepath)
            if content is None:
                continue

            is_valid, error_msg = check_agent_file(filepath, content)
            if not is_valid:
                errors.append(error_msg)

    if errors:
        print("\n❌ Pre-commit check failed:\n")
        for error in errors:
            print(error)
            print()
        print("💡 Private rules belong in *.local.md files (gitignored).")
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
